config CRYPTO_MITHRIL_DSEE_SHA
	bool "Mithril DSEE SHA Driver"
	default y
	depends on DT_HAS_MITHRIL_DSEE_HASH_ENABLED
    select USE_MITHRIL_HAL_DSEE_HASH
	help
	  This option enables the Mithril DSEE Hash Engine driver.

